/* components/checkin-sheet/checkin-sheet.wxss - 打卡弹窗样式 */

/* ===== 遮罩层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  transition: opacity 350ms ease;
}

.sheet-mask--visible {
  opacity: 1;
}

/* ===== 弹窗面板 ===== */
.sheet-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-secondary);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 350ms cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet-panel--visible {
  transform: translateY(0);
}

.sheet-panel--closing {
  transform: translateY(100%);
}

/* ===== 拖拽指示条 ===== */
.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.sheet-handle__bar {
  width: 64rpx;
  height: 8rpx;
  background: #DDDDDD;
  border-radius: 4rpx;
}

/* ===== 头部 ===== */
.sheet-header {
  padding: 0 var(--spacing-lg) var(--spacing-md);
}

.sheet-header__title {
  font-family: var(--font-pixel);
  font-size: var(--font-size-lg);
  font-weight: bold;
}

.sheet-header__subtitle {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-left: var(--spacing-sm);
}

/* ===== 情绪选择区 ===== */
.emotion-picker {
  padding: var(--spacing-md) var(--spacing-lg);
}

.emotion-picker__label {
  display: block;
  font-family: var(--font-pixel);
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-md);
}

.emotion-picker__grid {
  display: flex;
  justify-content: space-between;
}

/* ===== 情绪单项 ===== */
.emotion-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm);
  border-radius: var(--radius-md);
  transition: all 200ms ease;
  /* 6 等分：flex: 1 配合 flex-basis 实现均分 */
  flex: 1;
}

.emotion-item--selected {
  transform: scale(1.15);
  background: rgba(0, 0, 0, 0.05);
  animation: bounce 400ms ease forwards;
}

.emotion-item__emoji {
  font-size: 64rpx;
}

.emotion-item__label {
  font-size: var(--font-size-sm);
  margin-top: 8rpx;
}

/* 选中弹性回弹动画 */
@keyframes bounce {
  0% { transform: scale(1); }
  40% { transform: scale(1.3); }
  70% { transform: scale(0.9); }
  100% { transform: scale(1.15); }
}

/* ===== 文字输入区 ===== */
.comment-section {
  max-height: 0;
  overflow: hidden;
  transition: max-height 300ms ease;
  padding: 0 var(--spacing-lg);
}

.comment-section--visible {
  max-height: 400rpx;
}

.comment-input {
  width: 100%;
  min-height: 120rpx;
  padding: var(--spacing-md);
  background: var(--bg-primary);
  border-radius: var(--radius-md);
  font-family: var(--font-pixel);
  font-size: var(--font-size-md);
  box-sizing: border-box;
}

/* ===== 隐私开关 ===== */
.privacy-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) var(--spacing-lg);
}

.privacy-toggle__label {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

/* ===== 保存按钮 ===== */
.save-btn-wrapper {
  padding: var(--spacing-md) var(--spacing-lg);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: #DDDDDD;
  color: #999999;
  font-family: var(--font-pixel);
  font-size: var(--font-size-lg);
  border: none;
  transition: all 200ms ease;
  line-height: 88rpx;
}

.save-btn--active {
  background: var(--emotion-2);
  color: #FFFFFF;
}

/* ===== 底部安全区 ===== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
